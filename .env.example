# --- App ---
ENVIRONMENT=development            # development | staging | production
ENABLE_DOCS=true                   # Swagger at /docs
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_SITE_URL=http://localhost:3001   # invite / reset-password emails link here

# --- Database (Supabase > Connect > Session pooler) ---
# Use the session pooler (IPv4). The direct host db.<ref>.supabase.co is IPv6-only and fails on many
# networks and hosts. URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (Project Settings > API Keys). The secret key must never reach a frontend. ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Only for projects on the legacy HS256 JWT secret. Leave empty for asymmetric signing keys (JWKS is used).
SUPABASE_JWT_SECRET=

# --- Public enquiry form ---
ENQUIRY_RATE_LIMIT=5               # per IP...
ENQUIRY_RATE_WINDOW_SECONDS=600    # ...per 10 minutes
TURNSTILE_SECRET_KEY=              # empty = honeypot only

# --- Uploads ---
UPLOAD_MAX_BYTES=5242880
IMAGE_MAX_WIDTH=1920
THUMB_WIDTH=480

# --- Monitoring ---
SENTRY_DSN=
